{
  "manifest_version": 3,
  "name": "Safari-style New Tab",
  "version": "1.1.0",
  "description": "New tab page with a search bar and your bookmarks as a Safari-style grid with nested folders.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["bookmarks", "search", "theme"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "chrome_settings_overrides": {
    "homepage": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "safari-newtab@kfazilov.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
